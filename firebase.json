{
  "functions": [
    {
      "source": "functions",
      "codebase": "aqalym",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log",
        "*.local"
      ],
      "predeploy": ["npm --prefix functions run build"]
    }
  ],
  "hosting": {
    "public": "hosting",
    "cleanUrls": true,
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/support", "destination": "/index.html" },
      { "source": "/support/**", "destination": "/index.html" }
    ]
  }
}
